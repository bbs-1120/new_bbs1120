generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model accounts {
  id                  String  @id @default(uuid())
  user_id             String
  type                String
  provider            String
  provider_account_id String
  refresh_token       String?
  access_token        String?
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?
  users               users   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
}

model cpn_daily_data {
  id         String   @id @default(uuid())
  cpn_key    String
  cpn_name   String
  media_id   String
  date       DateTime @db.Date
  spend      Decimal  @db.Decimal(12, 2)
  revenue    Decimal  @db.Decimal(12, 2)
  profit     Decimal  @db.Decimal(12, 2)
  roas       Decimal  @db.Decimal(8, 2)
  cv         Int      @default(0)
  mcv        Int      @default(0)
  cpm        Decimal  @db.Decimal(10, 2)
  cpc        Decimal  @db.Decimal(10, 2)
  created_at DateTime @default(now())
  updated_at DateTime
  media      media    @relation(fields: [media_id], references: [id])

  @@unique([cpn_key, date])
  @@index([cpn_key])
  @@index([date])
  @@index([media_id])
}

model execution_logs {
  id            String   @id @default(uuid())
  executed_at   DateTime @default(now())
  executed_by   String
  action_type   String
  target_count  Int
  rule_version  String
  status        String
  error_message String?

  @@index([executed_at])
}

model invites {
  id           String    @id @default(uuid())
  email        String    @unique
  token        String    @unique
  role         String    @default("member")
  team_name    String?
  expires_at   DateTime
  used_at      DateTime?
  created_at   DateTime  @default(now())
  media_filter String?

  @@index([token])
}

model judgment_results {
  id                    String   @id @default(uuid())
  cpn_key               String
  cpn_name              String
  media_id              String
  judgment_date         DateTime @db.Date
  today_profit          Decimal  @db.Decimal(12, 2)
  profit_7days          Decimal  @db.Decimal(12, 2)
  roas_7days            Decimal  @db.Decimal(8, 2)
  consecutive_loss_days Int
  judgment              String
  reasons               String[]
  recommended_action    String
  manual_override       String?
  is_send_target        Boolean  @default(false)
  is_re                 Boolean
  created_at            DateTime @default(now())
  updated_at            DateTime
  media                 media    @relation(fields: [media_id], references: [id])

  @@unique([cpn_key, judgment_date])
  @@index([judgment_date])
  @@index([judgment])
}

model media {
  id               String             @id @default(uuid())
  name             String             @unique
  created_at       DateTime           @default(now())
  updated_at       DateTime
  cpn_daily_data   cpn_daily_data[]
  judgment_results judgment_results[]
}

model sessions {
  id            String   @id @default(uuid())
  session_token String   @unique
  user_id       String
  expires       DateTime
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model settings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updated_at  DateTime @updatedAt
}

model status_overrides {
  id         String   @id @default(uuid())
  cpn_key    String   @unique
  cpn_name   String
  media      String
  status     String
  changed_at DateTime @default(now())
  expires_at DateTime

  @@index([cpn_key])
  @@index([expires_at])
}

model users {
  id             String     @id @default(uuid())
  name           String?
  email          String     @unique
  email_verified DateTime?
  image          String?
  role           String     @default("member")
  created_at     DateTime   @default(now())
  updated_at     DateTime
  password       String?
  team_name      String?
  media_filter   String?
  accounts       accounts[]
  sessions       sessions[]
}

model verification_tokens {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model auto_stop_exclusions {
  id          String   @id @default(uuid())
  cpn_name    String   @unique
  cpn_key     String?
  reason      String?
  excluded_by String
  excluded_at DateTime @default(now())

  @@index([cpn_name])
}

model auto_stop_history {
  id            String   @id @default(uuid())
  cpn_name      String
  cpn_key       String?
  campaign_id   String?
  media         String
  member_name   String
  project_name  String
  rule_name     String
  conditions    Json
  metrics       Json
  stopped_at    DateTime @default(now())
  status        String
  error_message String?

  @@index([member_name])
  @@index([status])
  @@index([stopped_at])
}

model auto_stop_rules {
  id           String   @id @default(uuid())
  member_name  String
  project_name String
  media        String
  rule_name    String
  priority     Int
  conditions   Json
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime

  @@index([is_active])
  @@index([member_name, project_name, media])
}

model project_cr_links {
  id           String   @id @default(uuid())
  project_name String
  cpn_name     String   @unique
  drive_url    String
  description  String?
  created_at   DateTime @default(now())
  updated_at   DateTime

  @@index([project_name])
}

model project_reports {
  id              String   @id @default(uuid())
  project_name    String
  media           String
  week_key        String
  result_comment  String?
  insight_comment String?
  next_comment    String?
  created_at      DateTime @default(now())
  updated_at      DateTime

  @@unique([project_name, media, week_key])
  @@index([project_name])
  @@index([week_key])
}

model weekly_report_comments {
  id             String   @id @default(uuid())
  week_key       String
  member_name    String
  todo_comment   String?
  growth_comment String?
  shrink_comment String?
  created_at     DateTime @default(now())
  updated_at     DateTime
  todo_list      String?

  @@unique([week_key, member_name])
  @@index([member_name])
  @@index([week_key])
}

model user_settings {
  id               String   @id @default(uuid())
  sync_code        String   @unique
  dark_mode        Boolean  @default(false)
  cpn_memos        Json     @default("{}")
  dashboard_config Json     @default("{}")
  monthly_goal     Int      @default(0)
  alert_settings   Json     @default("{}")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}
