generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model accounts {
  id                  String  @id
  user_id             String
  type                String
  provider            String
  provider_account_id String
  refresh_token       String?
  access_token        String?
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?
  users               users   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
}

model cpn_daily_data {
  id         String   @id
  cpn_key    String
  cpn_name   String
  media_id   String
  date       DateTime @db.Date
  spend      Decimal  @db.Decimal(12, 2)
  revenue    Decimal  @db.Decimal(12, 2)
  profit     Decimal  @db.Decimal(12, 2)
  roas       Decimal  @db.Decimal(8, 2)
  cv         Int      @default(0)
  mcv        Int      @default(0)
  cpm        Decimal  @db.Decimal(10, 2)
  cpc        Decimal  @db.Decimal(10, 2)
  created_at DateTime @default(now())
  updated_at DateTime
  media      media    @relation(fields: [media_id], references: [id])

  @@unique([cpn_key, date])
  @@index([cpn_key])
  @@index([date])
  @@index([media_id])
}

model execution_logs {
  id            String   @id @default(uuid())
  executed_at   DateTime @default(now())
  executed_by   String
  action_type   String
  target_count  Int
  rule_version  String
  status        String
  error_message String?

  @@index([executed_at])
}

model invites {
  id         String    @id
  email      String    @unique
  token      String    @unique
  role       String    @default("member")
  team_name  String?
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([token])
}

model judgment_results {
  id                    String   @id
  cpn_key               String
  cpn_name              String
  media_id              String
  judgment_date         DateTime @db.Date
  today_profit          Decimal  @db.Decimal(12, 2)
  profit_7days          Decimal  @db.Decimal(12, 2)
  roas_7days            Decimal  @db.Decimal(8, 2)
  consecutive_loss_days Int
  judgment              String
  reasons               String[]
  recommended_action    String
  manual_override       String?
  is_send_target        Boolean  @default(false)
  is_re                 Boolean
  created_at            DateTime @default(now())
  updated_at            DateTime
  media                 media    @relation(fields: [media_id], references: [id])

  @@unique([cpn_key, judgment_date])
  @@index([judgment_date])
  @@index([judgment])
}

model media {
  id               String             @id
  name             String             @unique
  created_at       DateTime           @default(now())
  updated_at       DateTime
  cpn_daily_data   cpn_daily_data[]
  judgment_results judgment_results[]
}

model sessions {
  id            String   @id
  session_token String   @unique
  user_id       String
  expires       DateTime
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model settings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updated_at  DateTime @updatedAt
}

model status_overrides {
  id         String   @id
  cpn_key    String   @unique
  cpn_name   String
  media      String
  status     String
  changed_at DateTime @default(now())
  expires_at DateTime

  @@index([cpn_key])
  @@index([expires_at])
}

model users {
  id             String     @id
  name           String?
  email          String     @unique
  email_verified DateTime?
  image          String?
  role           String     @default("member")
  created_at     DateTime   @default(now())
  updated_at     DateTime
  password       String?
  team_name      String?
  accounts       accounts[]
  sessions       sessions[]
}

model verification_tokens {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model user_settings {
  id               String   @id @default(uuid())
  sync_code        String   @unique
  dark_mode        Boolean  @default(false)
  cpn_memos        Json     @default("{}")
  dashboard_config Json     @default("{}")
  monthly_goal     Int      @default(0)
  alert_settings   Json     @default("{}")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}
